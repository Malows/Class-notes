# Absolute path to the SQLite file. Required in production (docker: /app/data/class-notes.db);
# development falls back to ./class-notes.db.
DATABASE_PATH="class-notes.db"

# Demo fixtures hydrate a new database automatically in a development build.
# Production builds only insert them with this explicit opt-in (`pnpm db:seed`).
# SEED_DEMO_DATA="true"

# Log every SQL statement (noisy, off by default).
DB_VERBOSE="false"

# Public client-side flags
PUBLIC_SENTRY_ENABLED="false"
PUBLIC_SENTRY_DSN=""
PUBLIC_SENTRY_ENVIRONMENT="development"
PUBLIC_ANALYTICS_ENABLED="false"

# Private server-side observability settings
SENTRY_ENABLED="false"
SENTRY_DSN=""
PLAUSIBLE_HOST=""
PLAUSIBLE_DOMAIN=""
